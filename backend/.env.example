APP_NAME="Cycle Tracker API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# SQLite for quick local dev; swap for the docker-compose Postgres URL when running the full stack:
# DATABASE_URL=postgresql+asyncpg://cycle_tracker:cycle_tracker@db:5432/cycle_tracker
DATABASE_URL=sqlite+aiosqlite:///./cycle_tracker.db

SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
